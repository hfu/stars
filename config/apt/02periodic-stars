// Installed on stars as /etc/apt/apt.conf.d/02periodic-stars (root-owned).
// Refresh the package lists once a day via apt-daily.timer so that
// `apt list --upgradable` on the host reflects pending (security) updates.
// Lists only: nothing is downloaded or installed automatically — upgrades stay a
// supervised, user-attended step (see docs/KNOWN_FACTS.md).
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Download-Upgradeable-Packages "0";
APT::Periodic::AutocleanInterval "0";
APT::Periodic::Unattended-Upgrade "0";
